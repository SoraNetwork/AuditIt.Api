{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=auditit.db"
  },
  "Jwt": {
    "Issuer": "AuditItApi",
    "Audience": "AuditItApp",
    "Key": "your_super_secret_key_that_is_at_least_32_bytes_long"
  },
  "DingTalk": {
    "AppKey": "your_app_key",
    "AppSecret": "your_app_secret"
  },
  "Reminders": {
    "SweepIntervalMinutes": 10,
    "DueSoonLeadHours": 48
  },
  "Auth": {
    "BootstrapAdminNames": [],
    "DefaultRoleForNewUsers": "Operator"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
